<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/waseel_navy" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:layoutDirection="rtl">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="وصيل | WASEEL" android:textColor="@color/waseel_text"
                    android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مساعدك الشخصي للمكالمات" android:textColor="@color/waseel_cyan"
                    android:textSize="14sp" android:layout_marginTop="4dp" />
            </LinearLayout>
            <TextView android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="☎" android:textSize="25sp"
                android:textColor="@color/waseel_text" android:background="@drawable/bg_panel" />
        </LinearLayout>

        <TextView android:id="@+id/tvAssistantState" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="المساعد متوقف"
            android:textColor="@color/waseel_text" android:textSize="16sp"
            android:padding="18dp" android:layout_marginTop="22dp"
            android:background="@drawable/bg_panel" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleAssistant"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:text="تشغيل المساعد" android:layout_marginTop="12dp"
            app:cornerRadius="18dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="نظرة عامة" android:textColor="@color/waseel_text"
            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="24dp" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:useDefaultMargins="true">
            <TextView android:id="@+id/tvCallsToday" style="@style/WaseelStat" android:text="مكالمات اليوم&#10;—" />
            <TextView android:id="@+id/tvCallsWeek" style="@style/WaseelStat" android:text="هذا الأسبوع&#10;—" />
            <TextView android:id="@+id/tvCallsMonth" style="@style/WaseelStat" android:text="هذا الشهر&#10;—" />
            <TextView android:id="@+id/tvCallsTotal" style="@style/WaseelStat" android:text="إجمالي المكالمات&#10;—" />
            <TextView android:id="@+id/tvAnsweredToday" style="@style/WaseelStat" android:text="الواردة المجاب عليها اليوم&#10;—" />
            <TextView android:id="@+id/tvMissedToday" style="@style/WaseelStat" android:text="المكالمات الفائتة اليوم&#10;—" />
        </GridLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الوصول السريع" android:textColor="@color/waseel_text"
            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="22dp" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:useDefaultMargins="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalls"
                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                android:text="سجل المكالمات" app:icon="@android:drawable/ic_menu_recent_history" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnQuickReplies"
                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                android:text="الردود الجاهزة" app:icon="@android:drawable/ic_menu_edit" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReports"
                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                android:text="التقارير" app:icon="@android:drawable/ic_menu_sort_by_size" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnVoice"
                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                android:text="إعدادات الصوت" app:icon="@android:drawable/ic_lock_silent_mode_off" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings"
                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                android:text="شخصية المساعد" app:icon="@android:drawable/ic_menu_preferences" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFeatures"
                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                android:text="جميع الإعدادات" app:icon="@android:drawable/ic_menu_view" app:cornerRadius="16dp" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnPermissions"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="مراجعة صلاحيات الهاتف" android:layout_marginTop="10dp" app:cornerRadius="16dp" />
        <TextView android:id="@+id/tvEngineStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@drawable/bg_panel"
            android:padding="16dp" android:text="فحص الصوت المحلي: لم يتم الفحص بعد"
            android:textColor="@color/waseel_muted" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تنبيه: تشغيل المساعد لا يعني أن الهاتف يسمح بالرد التلقائي أو الوصول إلى صوت طرفي مكالمة SIM."
            android:textColor="@color/waseel_muted" android:textSize="12sp"
            android:padding="10dp" />
    </LinearLayout>
</ScrollView>