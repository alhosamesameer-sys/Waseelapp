    {
      "id": "where_owner",
      "questions": [
        "وين صاحب الهاتف",
        "وينه الحين",
        "هو بالبيت"
      ],
      "answer": "ما عندي صلاحية أشارك موقع صاحب الهاتف. تحب تترك له رسالة؟"
    },
    {
      "id": "when_owner_free",
      "questions": [
        "متى يرجع",
        "متى يفضى",
        "متى يتصل"
      ],
      "answer": "ما عندي وقت مؤكد، لكن أقدر أسجل طلبك."
