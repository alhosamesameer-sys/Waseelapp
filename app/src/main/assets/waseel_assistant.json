    "confirm_dates_times": true
  },
  "appointments": {
    "timezone": "Asia/Riyadh",
    "rules": [
      "ميّز دائماً بين موعد مقترح وموعد مؤكد.",
      "لا تضف موعداً إلى التقويم دون إذن.",
      "لا تفترض صباحاً أو مساءً."
