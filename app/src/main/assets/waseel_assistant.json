    "save_audio": true,
    "save_transcript": true,
    "save_assistant_replies": true,
    "require_caller_notice": true,
    "require_caller_consent": true,
    "require_owner_opt_in": true,
    "encrypt_audio_at_rest": true,
    "retention_days": 30,
    "activation_condition": "verified_duplex_call_audio_route_and_required_consents",
    "if_unavailable": "save_no_fake_recording_and_show_unavailable_status",
    "note": "المستخدم يريد الصوت والنص معاً، لكن لا يبدأ التسجيل الصوتي حتى يتوفر مصدر موثوق لصوت الطرفين وموافقات التسجيل."
  },
  "transcript": {
    "enabled": true,
    "speakers": [
