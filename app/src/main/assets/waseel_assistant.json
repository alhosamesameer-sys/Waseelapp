  },
  "fallbacks": {
    "speech_unavailable": "ميزة فهم الكلام غير متاحة على هذا الجهاز دون إنترنت. لن أستخدم خدمة خارجية.",
    "arabic_tts_unavailable": "الصوت العربي المحلي غير متوفر حالياً.",
    "unknown": "أعتذر منك، ما عندي معلومة مؤكدة. أقدر أسجل سؤالك لصاحب الهاتف."
  },
  "customization": {
    "add_edit_delete_rules": true,
    "test_rules": true,
    "import_export_json": true,
    "validate_before_apply": true,
    "backup_before_update": true,
    "restore_defaults": true
  },
  "platform_limitations": {
    "sim_audio": "لا توفر واجهات Android العامة لتطبيق عادي مسار صوت ثنائي الاتجاه للمكالمات الخلوية. لا يتم تسجيل الميكروفون على أنه صوت المكالمة.",
    "carrier_forwarding": "تحويل المكالمات يعتمد على شركة الاتصالات.",
    "whatsapp": "لا توجد واجهة عامة رسمية تتيح الرد الآلي على مكالمات WhatsApp الشخصية.",
    "offline_speech": "توفر التعرف والنطق العربي دون إنترنت يعتمد على محركات الجهاز.",
    "sip_pbx": "موصل SIP/PBX غير مثبت في هذه النسخة؛ يلزم تنفيذ بروتوكول SIP واختباره مع مزود متوافق.",
    "recording": "التسجيل الصوتي لا يعمل حتى يتوفر مصدر صوت موثوق للطرفين وموافقة المتصل وصاحب الهاتف."
  },
  "validation": {
