      "priority": 70,
      "phrases": [
        "عندي استفسار",
        "أبي أسأل",
        "عندي سؤال"
      ],
      "response": "تفضل، اذكر استفسارك وبسجله لصاحب الهاتف."
    },
    "unknown": {
      "priority": 0,
      "response": "أعتذر منك، ما فهمت طلبك بشكل واضح. ممكن توضحه لي بطريقة ثانية؟"
    }
  },
  "faq": [
    {
      "id": "who_are_you",
      "questions": [
        "من معي",
        "من أنت",
        "أنت مين"
      ],
      "answer": "أنا وصيل، المساعد الشخصي لصاحب الهاتف."
